import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int i;
        Scanner s=new Scanner(System.in);
        int mul=1;
        int a=s.nextInt();
        for(i=1;i<=a;i++)
        {
            mul=mul*i;
        }
        System.out.print(mul);
    }
}
