import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int i,x;
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        x=n;
        int sum=0;
       while(n>0){
           int d=n%10;
           sum=sum*10+d;
           n=n/10;
       }
        if(x==sum){
            System.out.println("Palindrome");
        }
        else{
             System.out.println("Not Palindrome");
        }
       
    }
}
