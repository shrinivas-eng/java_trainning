        Scanner s=new Scanner(System.in);
  
        int n=s.nextInt();
        int i,count=0;
      int x=0;
        int[] a =new int[50];
        for(i=0;i<n;i++) {
        a[i]=s.nextInt();
        }

         for(i=1;i<n;i++) {
         int temp=a[x]; 
        if(temp==a[i]){
            x++;
        }
       else
       {
        count++;
       }
       if(count==1)
      {
        System.out.println(a[i]);
      }
      }
      
      
       
    }
}
